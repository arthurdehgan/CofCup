<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For the optional "Vibrate on next step" chime companion. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- In-app QR scanner (phase 3 join); paste import stays the fallback. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".CupnlogApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CupnLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme: cofcup://import?v=1&d=… (still accepted everywhere). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="cofcup"
                    android:host="import" />
            </intent-filter>

            <!-- The https App Link the QR encodes; autoVerify resolves scans
                 straight into the app (assetlinks.json on the Pages host). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="arthurdehgan.github.io"
                    android:pathPrefix="/cupnlog/cofcup/i" />
            </intent-filter>
        </activity>
    </application>

</manifest>
